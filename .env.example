[TEMPLATE]
# Copy to .env.local (gitignored) or export these in your shell.

# Agnes 3.0 Flash API key — server-side only (https://platform.agnes-ai.com).
# Used by the Python backend for the natural-language -> AST fallback when the
# deterministic parser can't handle input.
AGNES_API_KEY=your_key_here

# Optional: override the local FastAPI backend URL that Next.js dev proxies to.
# API_BACKEND_URL=http://127.0.0.1:8000
