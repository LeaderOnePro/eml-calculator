# Copy to .env.local (gitignored) or export these in your shell.

# LongCat-2.0 API key — server-side only. Used by the Python backend for the
# natural-language -> AST fallback when the deterministic parser can't handle input.
LONGCAT_API_KEY=ak_your_key_here

# Optional: override the local FastAPI backend URL that Next.js dev proxies to.
# API_BACKEND_URL=http://127.0.0.1:8000
